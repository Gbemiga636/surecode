# SureCode — copy to `.env.local` / Vercel Environment Variables

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Public site URL (required on Vercel for auth redirects)
# Example: https://surecode.vercel.app
NEXT_PUBLIC_SITE_URL=

# Protect crawl API (manual + external cron-job.org)
CRAWL_SECRET=change-me-to-a-long-random-string

# Vercel Cron auth (Dashboard auto-uses this). Can match CRAWL_SECRET.
CRON_SECRET=change-me-to-a-long-random-string

# Optional: AI scout + slip rationale
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=7000

# Serverless-safe defaults (Vercel Hobby)
CRAWL_BUDGET_MS=45000
SPORTY_FETCH_MS=8000
SPORTY_PAGES=4
