# SureCode — copy to `.env.local` (never commit real keys)

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Public site URL (required on Netlify for auth redirects)
# Example: https://surecode.netlify.app
NEXT_PUBLIC_SITE_URL=

# Optional: AI scout + slip rationale (OpenAI-compatible)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=7000

# Protect manual / scheduled crawl triggers
CRAWL_SECRET=change-me-to-a-long-random-string

# Crawl / SportyBet timeouts (Netlify-safe defaults)
CRAWL_BUDGET_MS=20000
SPORTY_FETCH_MS=8000
